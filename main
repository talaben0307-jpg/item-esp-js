-- JJS Item ESP Script with Toggle UI
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Trạng thái ESP (Mặc định là bật)
local espEnabled = true

-- Cấu hình màu sắc ESP
local ESP_SETTINGS = {
    TextColor = Color3.fromRGB(0, 255, 128),         -- Màu chữ (Xanh lá sáng)
    HighlightFill = Color3.fromRGB(0, 255, 128),     -- Màu phủ bên trong Highlight
    HighlightOutline = Color3.fromRGB(255, 255, 255), -- Viền trắng nổi bật
}

-- Xóa UI cũ nếu có để tránh trùng lặp
if CoreGui:FindFirstChild("JJS_ESPToggleUI") then
    CoreGui.JJS_ESPToggleUI:Destroy()
end

-- Tạo GUI nút Bật/Tắt trên màn hình
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "JJS_ESPToggleUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ToggleButton"
toggleButton.Size = UDim2.new(0, 110, 0, 40)
toggleButton.Position = UDim2.new(0, 20, 0, 100) -- Vị trí ở góc trái màn hình
toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleButton.BorderColor3 = Color3.fromRGB(0, 255, 128)
toggleButton.BorderSizePixel = 2
toggleButton.Text = "ESP: ON"
toggleButton.TextColor3 = Color3.fromRGB(0, 255, 128)
toggleButton.TextScaled = true
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = screenGui

-- Hàm kiểm tra vật phẩm có thể cầm/nhặt
local function isPickableItem(obj)
    if not obj or not obj.Parent then return false end
    
    if obj:IsA("Tool") then
        return true
    end
    
    if obj:IsA("Model") or obj:IsA("BasePart") then
        if obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("ProximityPrompt") or obj:FindFirstChild("TouchInterest") then
            if not Players:GetPlayerFromCharacter(obj) then
                return true
            end
        end
    end
    
    return false
end

-- Hàm bật/tắt hiển thị của các ESP đã tạo
local function updateESPVisibility()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local hl = obj:FindFirstChild("JJS_ItemESP_Highlight")
        local ui = obj:FindFirstChild("JJS_ItemESP_UI")
        if hl then hl.Enabled = espEnabled end
        if ui then ui.Enabled = espEnabled end
    end
end

-- Hàm tạo ESP cho item
local function createESP(item)
    if not item or item:FindFirstChild("JJS_ItemESP_UI") then return end

    pcall(function()
        local highlight = Instance.new("Highlight")
        highlight.Name = "JJS_ItemESP_Highlight"
        highlight.FillColor = ESP_SETTINGS.HighlightFill
        highlight.OutlineColor = ESP_SETTINGS.HighlightOutline
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
        highlight.Adornee = item
        highlight.Enabled = espEnabled
        highlight.Parent = item

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "JJS_ItemESP_UI"
        billboard.Size = UDim2.new(0, 120, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = espEnabled
        
        if item:IsA("Model") then
            billboard.Adornee = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        else
            billboard.Adornee = item
        end

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "[ ITEM ] " .. item.Name
        textLabel.TextColor3 = ESP_SETTINGS.TextColor
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextStrokeTransparency = 0
        textLabel.Parent = billboard

        billboard.Parent = item
    end)
end

-- Xử lý sự kiện bấm nút Toggle
toggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        toggleButton.Text = "ESP: ON"
        toggleButton.TextColor3 = Color3.fromRGB(0, 255, 128)
        toggleButton.BorderColor3 = Color3.fromRGB(0, 255, 128)
    else
        toggleButton.Text = "ESP: OFF"
        toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.BorderColor3 = Color3.fromRGB(255, 60, 60)
    end
    updateESPVisibility()
end)

-- Quét item có sẵn
for _, obj in ipairs(Workspace:GetDescendants()) do
    if isPickableItem(obj) then
        createESP(obj)
    end
end

-- Lắng nghe item mới spawn
Workspace.DescendantAdded:Connect(function(child)
    task.spawn(function()
        task.wait(0.2)
        if isPickableItem(child) then
            createESP(child)
        end
    end)
end)

print("Đã thêm nút Bật/Tắt ESP thành công!")
