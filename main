-- JJS Item ESP Script - Fixed Continuous Scanning & All Items
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Load Fluent UI
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "JJS Item ESP | Ultimate",
    SubTitle = "Auto-Scan & Fix Missing Items",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.RightControl
})

local Tabs = {
    ESP = Window:AddTab({ Title = "Item ESP", Icon = "eye" })
}

-- Danh sách vật phẩm của bạn
local itemToggles = {
    ["Soda"] = false,
    ["Coin"] = false,
    ["Jet Black"] = false,
    ["Gun"] = false,
    ["Playful Cloud"] = false,
    ["Transfigured Flesh"] = false,
    ["Voice Recorder"] = false,
    ["Hazenoki's Eye"] = false,
    ["Sniper"] = false,
    ["Transfigured Human"] = false,
    ["Tinted Glasses"] = false,
    ["TNT"] = false,
    ["Banana Peel"] = false,
    ["Naginata"] = false,
    ["Bowling Ball"] = false,
    ["Crowbar"] = false,
}

local rainbowHighlights = {}

Tabs.ESP:AddParagraph({
    Title = "Quản lý ESP Vật Phẩm (Fixed)",
    Content = "Đã sửa lỗi không quét được Voice Recorder và các item spawn ẩn. Hệ thống sẽ tự động quét liên tục."
})

for itemName, _ in pairs(itemToggles) do
    Tabs.ESP:AddToggle(itemName .. "Toggle", {
        Title = "ESP: " .. itemName,
        Default = false,
        Callback = function(Value)
            itemToggles[itemName] = Value
        end
    })
end

-- Hàm tạo ESP cho item
local function createESP(item)
    if not item or not item.Parent then return end
    if item:FindFirstChild("JJS_ItemESP_UI") then return end

    pcall(function()
        local highlight = Instance.new("Highlight")
        highlight.Name = "JJS_ItemESP_Highlight"
        highlight.FillColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0
        highlight.Adornee = item
        highlight.Parent = item

        table.insert(rainbowHighlights, highlight)

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "JJS_ItemESP_UI"
        billboard.Size = UDim2.new(0, 80, 0, 25)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        
        if item:IsA("Model") then
            billboard.Adornee = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        else
            billboard.Adornee = item
        end

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = item.Name
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextSize = 12
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextStrokeTransparency = 0.3
        textLabel.Parent = billboard

        billboard.Parent = item
    end)
end

-- Quét định kỳ mỗi 0.5 giây để bắt trọn các item mới spawn hoặc item khó tính như Voice Recorder
task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if itemToggles[obj.Name] then
                    local ui = obj:FindFirstChild("JJS_ItemESP_UI")
                    local hl = obj:FindFirstChild("JJS_ItemESP_Highlight")
                    
                    if not ui or not hl then
                        createESP(obj)
                    else
                        -- Cập nhật trạng thái bật/tắt theo UI
                        ui.Enabled = itemToggles[obj.Name]
                        hl.Enabled = itemToggles[obj.Name]
                    end
                end
            end
        end)
    end
end)

-- Hiệu ứng Rainbow chuyển màu liên tục
RunService.RenderStepped:Connect(function()
    local hue = (tick() % 5) / 5
    local rainbowColor = Color3.fromHSV(hue, 1, 1)

    for i = #rainbowHighlights, 1, -1 do
        local hl = rainbowHighlights[i]
        if hl and hl.Parent then
            local parentName = hl.Parent.Name
            if itemToggles[parentName] then
                hl.FillColor = rainbowColor
                hl.OutlineColor = rainbowColor
                hl.Enabled = true
            else
                hl.Enabled = false
            end
        else
            table.remove(rainbowHighlights, i)
        end
    end
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "JJS Item ESP",
    Content = "Đã cập nhật quét liên tục thành công!",
    Duration = 4
})
