-- JJS Item ESP Script with Fluent UI & Custom Item Toggles
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Load Fluent UI từ thư viện chuẩn
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- Tạo cửa sổ Fluent UI
local Window = Fluent:CreateWindow({
    Title = "JJS Item ESP | Fluent UI",
    SubTitle = "Custom Item ESP Manager",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.RightControl
})

-- Tạo Tab chính
local Tabs = {
    ESP = Window:AddTab({ Title = "Item ESP", Icon = "eye" })
}

-- Danh sách cấu hình trạng thái từng item (Mặc định là tắt hoặc bật tùy bạn chọn)
local itemToggles = {
    ["Soda"] = false,
    ["Coin"] = false,
    ["Jet Black"] = false,
    ["Gun"] = false,
    ["Playful Cloud"] = false,
    ["Transfigured Flesh"] = false,
    ["Voice Recorder"] = false,
    ["Hazenoki's Eye"] = false,
    ["Sniper"] = false,
    ["Transfigured Human"] = false,
    ["Tinted Glasses"] = false,
    ["TNT"] = false,
    ["Banana Peel"] = false,
    ["Naginata"] = false,
    ["Bowling Ball"] = false,
    ["Crowbar"] = false,
}

-- Lưu trữ danh sách các Highlight để đổi màu Rainbow
local rainbowHighlights = {}

-- Tạo Toggle cho từng vật phẩm trên giao diện
Tabs.ESP:AddParagraph({
    Title = "Quản lý ESP Vật Phẩm",
    Content = "Bật công tắc của vật phẩm nào thì vật phẩm đó sẽ được ESP (Chữ nhỏ + Viền Rainbow)."
})

for itemName, _ in pairs(itemToggles) do
    Tabs.ESP:AddToggle(itemName .. "Toggle", {
        Title = "ESP: " .. itemName,
        Default = false,
        Callback = function(Value)
            itemToggles[itemName] = Value
            -- Cập nhật lại trạng thái hiển thị ngay lập tức nếu vật phẩm đã có sẵn trong map
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == itemName then
                    local hl = obj:FindFirstChild("JJS_ItemESP_Highlight")
                    local ui = obj:FindFirstChild("JJS_ItemESP_UI")
                    if hl then hl.Enabled = Value end
                    if ui then ui.Enabled = Value end
                end
            end
        end
    })
end

-- Hàm tạo ESP cho item khớp với tên trong danh sách
local function createESP(item)
    if not item or not item.Parent then return end
    if not itemToggles[item.Name] then return end -- Nếu tắt toggle thì không tạo
    if item:FindFirstChild("JJS_ItemESP_UI") then return end

    pcall(function()
        -- Highlight Rainbow
        local highlight = Instance.new("Highlight")
        highlight.Name = "JJS_ItemESP_Highlight"
        highlight.FillColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0
        highlight.Adornee = item
        highlight.Enabled = itemToggles[item.Name]
        highlight.Parent = item

        table.insert(rainbowHighlights, highlight)

        -- BillboardGui hiển thị tên nhỏ gọn
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "JJS_ItemESP_UI"
        billboard.Size = UDim2.new(0, 80, 0, 25)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = itemToggles[item.Name]
        
        if item:IsA("Model") then
            billboard.Adornee = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
        else
            billboard.Adornee = item
        end

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = item.Name
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextSize = 12
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextStrokeTransparency = 0.3
        textLabel.Parent = billboard

        billboard.Parent = item
    end)
end

-- Hiệu ứng đổi màu Rainbow liên tục cho các Highlight đang bật
RunService.RenderStepped:Connect(function()
    local hue = (tick() % 5) / 5
    local rainbowColor = Color3.fromHSV(hue, 1, 1)

    for i = #rainbowHighlights, 1, -1 do
        local hl = rainbowHighlights[i]
        if hl and hl.Parent then
            -- Chỉ đổi màu nếu toggle của item đó đang Bật
            local parentName = hl.Parent.Name
            if itemToggles[parentName] then
                hl.FillColor = rainbowColor
                hl.OutlineColor = rainbowColor
                hl.Enabled = true
            else
                hl.Enabled = false
            end
        else
            table.remove(rainbowHighlights, i)
        end
    end
end)

-- Quét toàn bộ map tìm các item có sẵn khớp tên
for _, obj in ipairs(Workspace:GetDescendants()) do
    if itemToggles[obj.Name] then
        createESP(obj)
    end
end

-- Lắng nghe khi có item mới spawn trong game
Workspace.DescendantAdded:Connect(function(child)
    task.spawn(function()
        task.wait(0.2)
        if itemToggles[child.Name] then
            createESP(child)
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "JJS Item ESP",
    Content = "Đã khởi động giao diện Fluent UI thành công!",
    Duration = 4
})
