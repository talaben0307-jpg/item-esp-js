-- JJS Item ESP Script - Small Text & Rainbow Highlight
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local espEnabled = true

-- Xóa UI cũ nếu có
if CoreGui:FindFirstChild("JJS_ESPToggleUI") then
    CoreGui.JJS_ESPToggleUI:Destroy()
end

-- Tạo GUI nút Bật/Tắt
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "JJS_ESPToggleUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ToggleButton"
toggleButton.Size = UDim2.new(0, 110, 0, 40)
toggleButton.Position = UDim2.new(0, 20, 0, 100)
toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleButton.BorderColor3 = Color3.fromRGB(0, 255, 128)
toggleButton.BorderSizePixel = 2
toggleButton.Text = "ESP: ON"
toggleButton.TextColor3 = Color3.fromRGB(0, 255, 128)
toggleButton.TextScaled = true
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = screenGui

-- Danh sách lưu các Highlight để chạy hiệu ứng Rainbow
local rainbowHighlights = {}

-- Hàm kiểm tra vật phẩm nhặt được
local function isPickableItem(obj)
    if not obj or not obj.Parent then return false end
    if obj:IsA("Tool") then return true end
    if obj:IsA("Model") or obj:IsA("BasePart") then
        if obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("ProximityPrompt") or obj:FindFirstChild("TouchInterest") then
            if not Players:GetPlayerFromCharacter(obj) then
                return true
            end
        end
    end
    return false
end

-- Cập nhật hiển thị Bật/Tắt
local function updateESPVisibility()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local hl = obj:FindFirstChild("JJS_ItemESP_Highlight")
        local ui = obj:FindFirstChild("JJS_ItemESP_UI")
        if hl then hl.Enabled = espEnabled end
        if ui then ui.Enabled = espEnabled end
    end
end

-- Hàm tạo ESP cho item (Chữ nhỏ lại)
local function createESP(item)
    if not item or item:FindFirstChild("JJS_ItemESP_UI") then return end

    pcall(function()
        local highlight = Instance.new("Highlight")
        highlight.Name = "JJS_ItemESP_Highlight"
        highlight.FillColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0
        highlight.Adornee = item
        highlight.Enabled = espEnabled
        highlight.Parent = item

        -- Đưa vào bảng để chạy hiệu ứng Rainbow
        table.insert(rainbowHighlights, highlight)

        -- Thu nhỏ kích thước BillboardGui lại (StudsSize nhỏ hơn, không dùng TextScaled quá to)
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "JJS_ItemESP_UI"
        billboard.Size = UDim2.new(0, 80, 0, 25) -- Kích thước nhỏ gọn
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = espEnabled
        
        if item:IsA("Model") then
            billboard.Adornee = item.PrimaryPart or item:FindFirstChildWhichIsA("BaseProximityPrompt") or item:FindFirstChildWhichIsA("BasePart")
        else
            billboard.Adornee = item
        end

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = item.Name
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextSize = 12 -- Cỡ chữ cố định nhỏ gọn, không bị bự chảng
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextStrokeTransparency = 0.3
        textLabel.Parent = billboard

        billboard.Parent = item
    end)
end

-- Hiệu ứng Rainbow chuyển màu liên tục cho Highlight
RunService.RenderStepped:Connect(function()
    local hue = (tick() % 5) / 5 -- Chu kỳ đổi màu trong 5 giây
    local rainbowColor = Color3.fromHSV(hue, 1, 1)

    for i = #rainbowHighlights, 1, -1 do
        local hl = rainbowHighlights[i]
        if hl and hl.Parent then
            hl.FillColor = rainbowColor
            hl.OutlineColor = rainbowColor
        else
            table.remove(rainbowHighlights, i)
        end
    end
end)

-- Xử lý nút bấm Toggle
toggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        toggleButton.Text = "ESP: ON"
        toggleButton.TextColor3 = Color3.fromRGB(0, 255, 128)
        toggleButton.BorderColor3 = Color3.fromRGB(0, 255, 128)
    else
        toggleButton.Text = "ESP: OFF"
        toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.BorderColor3 = Color3.fromRGB(255, 60, 60)
    end
    updateESPVisibility()
end)

-- Quét item sẵn có
for _, obj in ipairs(Workspace:GetDescendants()) do
    if isPickableItem(obj) then
        createESP(obj)
    end
end

-- Lắng nghe item mới spawn
Workspace.DescendantAdded:Connect(function(child)
    task.spawn(function()
        task.wait(0.2)
        if isPickableItem(child) then
            createESP(child)
        end
    end)
end)

print("Đã cập nhật: Chữ nhỏ lại & Highlight Rainbow thành công!")
